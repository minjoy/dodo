// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 사용자
model User {
  id            String    @id @default(cuid())
  kakaoId       String    @unique
  email         String?
  nickname      String    @unique
  profileImage  String?   @db.Text
  bio           String?   @db.Text
  ageRange      String?   // 카카오 연령대 (예: "20~29")

  // 동네 정보
  region        String    // 예: "성수동"
  regionCode    String?   // 법정동 코드

  // 레벨 시스템
  level         Int       @default(1)  // 1~5
  exp           Int       @default(0)

  // 통계
  meetingCount  Int       @default(0)  // 참여 횟수
  hostCount     Int       @default(0)  // 개설 횟수
  likeReceived  Int       @default(0)  // 받은 좋아요
  noShowCount   Int       @default(0)  // 노쇼 횟수

  // 대표 뱃지 (최대 2개)
  representativeBadgeId  String?
  representativeBadge    Badge?    @relation("RepresentativeBadge1", fields: [representativeBadgeId], references: [id])
  representativeBadge2Id String?
  representativeBadge2   Badge?    @relation("RepresentativeBadge2", fields: [representativeBadge2Id], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 얼리버드 뱃지용 (첫 모임 열람 여부)
  hasViewedMeeting  Boolean   @default(false)

  // 관계
  hostedMeetings    Meeting[]       @relation("HostedMeetings")
  participations    Participant[]
  reviewsGiven      Review[]        @relation("ReviewsGiven")
  reviewsReceived   Review[]        @relation("ReviewsReceived")
  badges            UserBadge[]
  reportsGiven      Report[]        @relation("ReportsGiven")
  reportsReceived   Report[]        @relation("ReportsReceived")
  gameRoles         GameRole[]
  pushSubscriptions PushSubscription[]
  shouts            Shout[]
  meetingComments   MeetingComment[]

  @@index([region])
  @@index([level])
}

// 모임
model Meeting {
  id            String    @id @default(cuid())
  shareCode     String    @unique  // 6자리 공유 코드 (예: "ABC123")

  // 기본 정보
  title         String
  description   String?   @db.Text
  gameType      GameType  @default(GYEONGDO)

  // 일시
  meetingDate   DateTime
  duration      Int       @default(120)  // 분 단위

  // 장소
  region        String
  placeName     String
  address       String
  latitude      Float
  longitude     Float

  // 모집
  maxParticipants   Int
  minLevel          Int       @default(1)
  password          String?   // 비밀번호 (선택)

  // 상태
  status        MeetingStatus @default(RECRUITING)

  // 게임 진행 상태
  gameStartedAt DateTime?     // 게임 시작 시간
  gameEndedAt   DateTime?     // 게임 종료 시간
  policeCount   Int?          // 경찰 인원 수
  thiefCount    Int?          // 도둑 인원 수

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 관계
  hostId        String
  host          User      @relation("HostedMeetings", fields: [hostId], references: [id])
  participants  Participant[]
  reviews       Review[]
  gameRoles     GameRole[]    // 게임별 역할 기록
  comments      MeetingComment[]

  @@index([region])
  @@index([meetingDate])
  @@index([status])
}

// 게임 종류
enum GameType {
  GYEONGDO      // 경찰과 도둑
  SULRAE        // 술래잡기
  MUGUNGHWA     // 무궁화 꽃이 피었습니다
  PIGU          // 피구
  OTHER         // 기타
}

// 모임 상태
enum MeetingStatus {
  RECRUITING    // 모집중
  CLOSED        // 모집마감
  READY         // 레디 대기중
  PLAYING       // 게임 진행중
  COMPLETED     // 완료
  CANCELLED     // 취소됨
}

// 참가자
model Participant {
  id          String    @id @default(cuid())

  status      ParticipantStatus @default(PENDING)
  joinedAt    DateTime  @default(now())
  attendedAt  DateTime? // 실제 참석 확인 시간

  // 레디 상태
  isReady     Boolean   @default(false)
  readyAt     DateTime?
  readyLat    Float?    // 레디 시 위치
  readyLng    Float?

  meetingId   String
  meeting     Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  userId      String
  user        User      @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
}

// 참가 상태
enum ParticipantStatus {
  PENDING     // 대기중
  CONFIRMED   // 확정
  ATTENDED    // 참석완료
  NOSHOW      // 노쇼
  CANCELLED   // 취소
}

// 게임 역할
model GameRole {
  id          String    @id @default(cuid())

  role        RoleType
  assignedAt  DateTime  @default(now())

  meetingId   String
  meeting     Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  userId      String
  user        User      @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
}

// 역할 타입
enum RoleType {
  POLICE      // 경찰
  THIEF       // 도둑
}

// 리뷰/평가
model Review {
  id          String    @id @default(cuid())

  rating      Int       // 1~5
  comment     String?   @db.Text
  isLike      Boolean   @default(false)  // 좋아요 여부

  createdAt   DateTime  @default(now())

  meetingId   String
  meeting     Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  reviewerId  String
  reviewer    User      @relation("ReviewsGiven", fields: [reviewerId], references: [id])

  revieweeId  String
  reviewee    User      @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  @@unique([meetingId, reviewerId, revieweeId])
  @@index([revieweeId])
}

// 배지
model Badge {
  id          String    @id @default(cuid())

  code        String    @unique  // FIRST_MEETING, GYEONGDO_10, HOST_FIRST 등
  name        String
  description String
  icon        String
  category    String    @default("general")  // general, meeting, host, social

  userBadges         UserBadge[]
  representedBy1     User[]      @relation("RepresentativeBadge1")
  representedBy2     User[]      @relation("RepresentativeBadge2")
}

// 사용자 배지 (획득)
model UserBadge {
  id          String    @id @default(cuid())
  earnedAt    DateTime  @default(now())

  userId      String
  user        User      @relation(fields: [userId], references: [id])

  badgeId     String
  badge       Badge     @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

// 신고
model Report {
  id          String    @id @default(cuid())

  reason      ReportReason
  description String?   @db.Text
  status      ReportStatus  @default(PENDING)

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  reporterId  String
  reporter    User      @relation("ReportsGiven", fields: [reporterId], references: [id])

  reportedId  String
  reported    User      @relation("ReportsReceived", fields: [reportedId], references: [id])

  meetingId   String?   // 관련 모임 (선택)

  @@index([reporterId])
  @@index([reportedId])
}

// 신고 사유
enum ReportReason {
  INAPPROPRIATE_BEHAVIOR  // 부적절한 행동
  NO_SHOW                 // 노쇼
  HARASSMENT              // 괴롭힘
  SPAM                    // 스팸
  FAKE_PROFILE            // 허위 프로필
  OTHER                   // 기타
}

// 신고 처리 상태
enum ReportStatus {
  PENDING     // 대기중
  REVIEWED    // 검토됨
  RESOLVED    // 해결됨
  DISMISSED   // 기각됨
}

// 푸시 구독
model PushSubscription {
  id          String    @id @default(cuid())

  endpoint    String    @unique @db.VarChar(500)
  p256dh      String    @db.Text
  auth        String    @db.Text

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@index([userId])
}

// 떠들기 (전광판 메시지)
model Shout {
  id          String    @id @default(cuid())

  message     String    @db.VarChar(50)  // 최대 50자

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
}

// 모임 게시판 댓글
model MeetingComment {
  id          String    @id @default(cuid())

  content     String    @db.VarChar(200)  // 최대 200자

  meetingId   String
  meeting     Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([meetingId])
  @@index([userId])
}
